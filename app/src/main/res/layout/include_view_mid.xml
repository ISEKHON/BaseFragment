<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="12dp"
        android:orientation="vertical"
        android:paddingLeft="4dp"
        android:paddingRight="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <xyz.illuminate.ui.Components.FontTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:layout_weight="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="What's new"
                android:textSize="16sp"
                app:fontPath="opensans_semibold.ttf"
                app:themeKey="windowBackgroundWhiteBlackText" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginBottom="2dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:scaleType="centerCrop"
                android:src="@drawable/search_arrow" />
        </LinearLayout>

        <xyz.illuminate.ui.Components.SpanTextView
            android:id="@+id/content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:fontFamily="@font/opensans_semibold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/PermissionBackgroundLocation"
            android:textSize="14sp"
            app:themeKey="windowBackgroundWhiteBlackText" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/screenshots_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="4dp">


        <xyz.illuminate.ui.Components.FontTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="8dp"
            android:text="Comment Section"
            android:textSize="16sp"
            app:fontPath="opensans_bold.ttf"
            app:themeKey="windowBackgroundWhiteBlackText" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginBottom="2dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:scaleType="centerCrop"
            android:src="@drawable/search_arrow" />
    </LinearLayout>

</LinearLayout>