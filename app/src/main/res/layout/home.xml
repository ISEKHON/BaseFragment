<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:fitsSystemWindows="true">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            app:elevation="0.0dip">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardview_search"
                android:layout_width="fill_parent"
                android:layout_height="56.0dip"
                android:layout_marginStart="16.0dip"
                android:layout_marginTop="8.0dip"
                android:layout_marginEnd="16.0dip"
                android:layout_marginBottom="8.0dip"
                app:cardCornerRadius="8.0dip"
                app:layout_scrollFlags="scroll|enterAlways">

                <LinearLayout
                    android:id="@+id/linearsearch"
                    android:layout_width="fill_parent"
                    android:layout_height="56.0dip"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="8.0dip">

                    <ImageView
                        android:id="@+id/img_drawer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8.0dip"
                        android:layout_marginEnd="8.0dip"
                        android:focusable="false"
                        android:scaleType="fitCenter"
                        android:src="@drawable/default_image" />

                    <LinearLayout
                        android:id="@+id/linear_title"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txt_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:gravity="center"
                            android:singleLine="true"
                            android:text="Sketchub"
                            android:textColor="#ffe0e3e5"
                            android:textSize="20.0sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textview1"
                        android:layout_width="wrap_content"
                        android:layout_height="fill_parent"
                        android:layout_weight="1.0"
                        android:focusable="false"
                        android:paddingStart="12.0dip"
                        android:paddingTop="8.0dip"
                        android:paddingEnd="8.0dip"
                        android:paddingBottom="8.0dip"
                        android:text="Search"
                        android:textColor="#ff808080"
                        android:textSize="16.0sp" />

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/img_account"
                        android:layout_width="40.0dip"
                        android:layout_height="40.0dip"
                        android:padding="2.0dip"
                        android:src="@drawable/ic_ab_done"
                        app:civ_border_color="#ffe0e0e0"
                        app:civ_border_overlay="true"
                        app:civ_border_width="1.0dip"
                        app:civ_circle_background_color="#00cccccc" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/home_nsv"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <FrameLayout
                android:id="@+id/linear_nav"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:focusableInTouchMode="true"
                android:orientation="vertical" />
        </androidx.core.widget.NestedScrollView>

        <FrameLayout
            android:id="@+id/linear_bottom_tabs"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:elevation="0.0dip"
            android:orientation="vertical" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</RelativeLayout>
