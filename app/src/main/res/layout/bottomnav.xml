<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/linear_root"
        android:layout_width="fill_parent"
        android:layout_height="58.0dip"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/linear_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/img_home"
                android:layout_width="25.0dip"
                android:layout_height="25.0dip"
                android:focusable="false"
                android:paddingTop="4.0dip"
                android:scaleType="fitCenter"
                android:src="@drawable/default_image" />

            <TextView
                android:id="@+id/txt_bt_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:paddingLeft="2.0dip"
                android:paddingRight="2.0dip"
                android:paddingBottom="2.0dip"
                android:text="Home"
                android:textColor="#ff212121"
                android:textSize="12.0sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linear_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/img_all"
                android:layout_width="25.0dip"
                android:layout_height="25.0dip"
                android:focusable="false"
                android:paddingLeft="4.0dip"
                android:scaleType="fitCenter"
                android:src="@drawable/default_image" />

            <TextView
                android:id="@+id/txt_bt_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:paddingLeft="2.0dip"
                android:paddingRight="2.0dip"
                android:paddingBottom="2.0dip"
                android:text="All Apps"
                android:textColor="#ffe0e3e5"
                android:textSize="12.0sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linear_announcement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/img_dot"
                android:layout_width="10.0dip"
                android:layout_height="10.0dip"
                android:layout_gravity="right"
                android:focusable="false"
                android:scaleType="fitCenter"
                android:src="@drawable/default_image"
                android:translationX="-5.0dip"
                android:translationY="5.0dip" />

            <xyz.illuminate.ui.Components.BadgeImageView
                android:id="@+id/img_announcement"
                android:layout_width="25.0dip"
                android:layout_height="25.0dip"
                android:focusable="false"
                android:paddingTop="4.0dip"
                android:scaleType="fitCenter"
                android:src="@drawable/default_image" />

            <TextView
                android:id="@+id/txt_bt_news"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:paddingLeft="2.0dip"
                android:paddingRight="2.0dip"
                android:paddingBottom="2.0dip"
                android:text="News"
                android:textColor="#ffe0e3e5"
                android:textSize="12.0sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linear_categories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/img_categories"
                android:layout_width="25.0dip"
                android:layout_height="25.0dip"
                android:focusable="false"
                android:paddingTop="4.0dip"
                android:scaleType="fitCenter"
                android:src="@drawable/default_image" />

            <TextView
                android:id="@+id/txt_bt_categories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:paddingLeft="2.0dip"
                android:paddingRight="2.0dip"
                android:paddingBottom="2.0dip"
                android:text="Category"
                android:textColor="#ffe0e3e5"
                android:textSize="12.0sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
